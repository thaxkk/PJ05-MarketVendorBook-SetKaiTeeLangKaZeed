{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express"
    },
    "client": {
      "root": "client",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "app" }
    },
    {
      "source": "/api-docs(.*)",
      "destination": { "service": "app" }
    },
    {
      "source": "/health",
      "destination": { "service": "app" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}
